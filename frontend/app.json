{
  "expo": {
    "name": "FamilyHome",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.ourstory.ff6oeh",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Share family photos in posts and profiles",
        "NSCameraUsageDescription": "Capture family moments to share",
        "NSMicrophoneUsageDescription": "Record voice messages for your family",
        "NSFaceIDUsageDescription": "Unlock your private Family Vault",
        "NSLocationWhenInUseUsageDescription": "Share your location during a family SOS"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF6B6B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.ourstory.ff6oeh",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Share family photos in posts and profiles"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF6B6B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice messages for your family"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B6B"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private Family Vault"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your location during a family SOS"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
