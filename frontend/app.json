{
  "expo": {
    "name": "FamilyHome",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.ourstory.ff6oeh",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Share family photos in posts and profiles",
        "NSCameraUsageDescription": "Capture family moments to share"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF6B6B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.ourstory.ff6oeh",
      "permissions": ["READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Share family photos in posts and profiles"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF6B6B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}